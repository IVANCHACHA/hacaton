<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sorter_pak</name>
  <version>0.1.0</version>
  <description>
    Track 3 (Ozon Robozon) PAK: item classification (B/C/D) + 2-shiber
    executive routing on the feed conveyor. See README.md and REPORT.md.
  </description>
  <maintainer email="dev@example.com">sorter_pak team</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>ament_index_python</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>

  <!-- only needed for launch/gz_launch.py (Gazebo Harmonic track,
       docs/GAZEBO.md); the pure-Python and ROS2 topic-only tracks
       (launch/sim_launch.py) do not require these. -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
